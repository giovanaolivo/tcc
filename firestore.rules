rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutenticado() {
      return request.auth != null;
    }

    match /registros_sintomas/{registroId} {
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow read, delete: if estaAutenticado()
                          && resource.data.usuarioId == request.auth.uid;
      allow update: if estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid
                    && request.resource.data.usuarioId == request.auth.uid;
    }

    match /registros_alimentacao/{registroId} {
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow read, delete: if estaAutenticado()
                          && resource.data.usuarioId == request.auth.uid;
      allow update: if estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid
                    && request.resource.data.usuarioId == request.auth.uid;
    }

    match /registros_habitos/{registroId} {
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow read, delete: if estaAutenticado()
                          && resource.data.usuarioId == request.auth.uid;
      allow update: if estaAutenticado()
                    && resource.data.usuarioId == request.auth.uid
                    && request.resource.data.usuarioId == request.auth.uid;
    }
  }
}
